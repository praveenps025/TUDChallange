# Copy to .env and fill in. .env is git-ignored; never commit real values.
# docker compose and the backend (./mvnw spring-boot:run) both read it.

# --- Database (docker-compose.yml) ---
DB_NAME=equiptrack
DB_USERNAME=equiptrack
DB_PASSWORD=change-me
DB_PORT=5432
# DB_URL=jdbc:postgresql://localhost:5432/equiptrack

# --- Backend secrets ---
# Generate each with: openssl rand -base64 48
JWT_SECRET=
MRN_HASH_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Dev logins (dev profile only) ---
# alex.morgan and jordan.lee (MANAGER) use DEV_MANAGER_PASSWORD;
# sam.patel and riley.chen (OT_STAFF) use DEV_STAFF_PASSWORD.
# Users are created on first start if these are set.
DEV_MANAGER_PASSWORD=
DEV_STAFF_PASSWORD=

# --- Frontend (put this one in .env.local) ---
# Leave unset to use the built-in sample data (src/mockData.js).
# VITE_API_URL=/api   (passed through to the backend by the dev server; see vite.config.js)
